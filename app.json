{
  "expo": {
    "name": "FIT.PERSONA",
    "slug": "fit-persona",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitpersona",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFEA00"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fitpersona.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFEA00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5eabdb9c-3837-4c35-a685-b521aee7d276"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "FIT.PERSONA",
      "shortName": "FitPersona",
      "themeColor": "#FFEA00",
      "backgroundColor": "#FFEA00",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
