{
  "name": "fit-persona",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run src/__tests__/firestoreRules.test.ts\"",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "tsc -b && vite build && firebase deploy"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "firebase": "^12.14.0",
    "nanoid": "^5.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.16.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
