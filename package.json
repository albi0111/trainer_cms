{
  "name": "fit-persona",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check:scroll-refresh": "node scripts/check-scroll-refresh-guard.mjs",
    "typecheck": "tsc -b",
    "guard": "npm run typecheck && npm run build",
    "build": "npm run check:scroll-refresh && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "nanoid": "^5.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "firebase-tools": "^15.16.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^1.0.0"
  }
}
